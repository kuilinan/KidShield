<?xml version="1.0" encoding="utf-8"?>
<!-- 黏土橙色按钮：带按压下沉效果 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下：阴影消失+颜色变深 = 软软按下去 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/kid_clay_primary_shadow" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/kid_clay_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 默认：底部阴影 5dp -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/kid_clay_primary_shadow" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="@color/kid_clay_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
